# Copy to .env and edit, then `docker compose up -d`.

# System user password, applied on the first `docker compose up`.
CONECTDESK_SYSTEM_USER_PASSWORD=

# Platform dashboard (super admin), at admin.<base_domain> when multi-tenancy
# is on in config.toml. Created, or its password reset, on every start; the
# password needs 10+ characters with upper and lower case, a digit and a symbol.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Postgres
POSTGRES_USER=conectdesk
POSTGRES_PASSWORD=conectdesk
POSTGRES_DB=conectdesk

# Meta app for WhatsApp, Messenger and Instagram (see META_CHANNELS.md). Set
# here or under [meta] in config.toml.
# CONECTDESK_META__APP_ID=
# CONECTDESK_META__APP_SECRET=
# CONECTDESK_META__WEBHOOK_VERIFY_TOKEN=
# CONECTDESK_META__WHATSAPP_CONFIG_ID=
# CONECTDESK_META__LOGIN_CONFIG_ID=

TZ=Asia/Kolkata

# App image. Leave unset to build from source (Dockerfile.dev); set to a
# published tag such as conectdesk/conectdesk:latest to pull a release instead.
# CONECTDESK_IMAGE=conectdesk/conectdesk:dev
# CONECTDESK_VERSION=v0.0.0-dev
